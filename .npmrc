# 本机（2026-10-16 接手时）实测：从 GitHub Releases 直接下载 electron 二进制
# 会长时间卡在 0 字节（连上了 185.199.109.133:443 却没有数据），
# `npm install` 因此永远跑不完。改用 npmmirror 的镜像即可。
#
# 注意：这里**不动 registry** —— npm 包本身从 registry.npmjs.org 拿是通的，
# 慢的只是 electron / electron-builder 的二进制包。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
