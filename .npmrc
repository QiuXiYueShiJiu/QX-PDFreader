# 国内网络直连 GitHub Releases 下载 electron 二进制容易卡在 0 字节，
# npm install 因此可能永远跑不完。改用 npmmirror 的镜像即可。
#
# 注意：这里**不动 registry** —— npm 包本身从 registry.npmjs.org 拿是通的，
# 慢的只是 electron / electron-builder 的二进制包。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
