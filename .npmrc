# 从 GitHub Releases 直接下载 electron 二进制在部分网络环境下会长时间卡住，
# `npm install` 因此跑不完。改用 npmmirror 的镜像即可。
#
# 注意：这里**不动 registry** —— npm 包本身从 registry.npmjs.org 拿是通的，
# 慢的只是 electron / electron-builder 的二进制包。
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
