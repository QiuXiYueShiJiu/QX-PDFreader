<Project Sdk="Microsoft.NET.Sdk">

  <!--
    虚拟桌面启动器。

    用途：把 GUI 测试程序放到独立的 Windows 桌面上运行，
    避免窗口弹到用户屏幕上抢焦点（这是硬性测试要求）。

    发布方式与 sb-native 一致：框架依赖 + apphost，
    因为本机没有 C++ 链接器，NativeAOT 不可用。
  -->

  <PropertyGroup>
    <!--
      必须是 WinExe（Windows GUI 子系统）而不是 Exe。
      用 Exe 会弹出一个控制台黑窗，测试时同样干扰用户，
      用户明确要求「控制台窗口也不要弹出」。
      代价：没有标准输出与标准错误，状态改为写日志文件。
      注意：XML 注释里不能出现连续两个减号，因此参数名与分隔线都不写进来。
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>desktop-launcher</AssemblyName>
    <RootNamespace>DesktopLauncher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="desktop-launcher.cs" />
  </ItemGroup>

</Project>
