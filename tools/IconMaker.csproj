<Project Sdk="Microsoft.NET.Sdk">

  <!--
    图标生成器。
    用 System.Drawing 绘制「大写 P + 小写 df」的应用图标与 PDF 文件图标，
    并打包成多尺寸 ICO（16/24/32/48/64/128/256）。

    发布方式与其它工具一致：框架依赖 + apphost。
    注意：System.Drawing 在 .NET 6+ 是 Windows 专用包，
    因此这里用 net8.0-windows 目标框架并显式引用它。
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>false</UseWindowsForms>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>icon-maker</AssemblyName>
    <RootNamespace>IconMaker</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="icon-maker.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
